  </style>
</head>
<body>

  <div class="card">
    <h2>Add New User</h2>
    <div class="flex-row">
      <input type="number" id="newId" placeholder="ID (1-127)" min="1" max="127">
      <input type="text" id="newName" placeholder="User Name" maxlength="14">
